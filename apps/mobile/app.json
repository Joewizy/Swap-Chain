{
  "expo": {
    "name": "Railglide",
    "slug": "railglide",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "railglide",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.railglide.mobile"
    },
    "android": {
      "package": "app.railglide.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F8F6F1"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "backgroundColor": "#F8F6F1",
          "resizeMode": "contain"
        }
      ],
      "react-native-quick-crypto",
      "expo-build-properties"
    ],
    "extra": {
      "eas": {}
    }
  }
}
