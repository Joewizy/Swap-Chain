{
  "expo": {
    "name": "Railglide",
    "slug": "railglide",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "railglide",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.railglide.mobile"
    },
    "android": {
      "package": "app.railglide.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F1",
          "resizeMode": "contain"
        }
      ],
      "react-native-quick-crypto",
      "expo-build-properties"
    ],
    "extra": {
      "eas": {}
    }
  }
}
