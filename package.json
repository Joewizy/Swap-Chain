{
  "name": "railglide",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run web:dev",
    "android": "npm run android -w mobile",
    "ios": "npm run ios -w mobile",
    "mobile": "npm run start -w mobile",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:lint": "npm run lint -w web",
    "web:typecheck": "npm run typecheck -w web",
    "web:check": "npm run check -w web"
  },
  "overrides": {
    "@relayprotocol/relay-kit-ui": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  }
}
